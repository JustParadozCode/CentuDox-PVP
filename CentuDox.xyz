local SAVE_FILE = "CentuDox_KeySystem_Storage.txt"

local function getSavedKey()
    if readfile and pcall(readfile, SAVE_FILE) then
        local success, content = pcall(readfile, SAVE_FILE)
        if success and content and #content > 0 then
            return content
        end
    end
    return ""
end

local function saveKey(key)
    if writefile then
        pcall(writefile, SAVE_FILE, key)
    end
end

local apiSuccess, api = pcall(function()
    return loadstring(game:HttpGet("https://sdkapi-public.luarmor.net/library.lua"))()
end)

if not apiSuccess or not api then
    return
end

api.script_id = PROJECT_ID

local gui = Instance.new("ScreenGui")
gui.Name = "CentuDoxKeySystem"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local parent = PlayerGui
pcall(function()
    if gethui then parent = gethui() end
end)
gui.Parent = parent

local function create(class, props, parentObject)
    local obj = Instance.new(class)
    for property, value in pairs(props) do
        obj[property] = value
    end
    obj.Parent = parentObject
    return obj
end

local function corner(object, radius)
    create("UICorner", { CornerRadius = UDim.new(0, radius) }, object)
end

local function stroke(object, color, thickness, transparency)
    return create("UIStroke", {
        Color = color,
        Thickness = thickness,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    }, object)
end

local function tween(object, duration, properties)
    local animation = TweenService:Create(
        object,
        TweenInfo.new(duration, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
        properties
    )
    animation:Play()
    return animation
end

