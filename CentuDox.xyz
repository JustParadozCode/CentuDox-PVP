local function setStatus(msg, col)
    statusLabel.Text = "●  " .. msg
    statusLabel.TextColor3 = col
end

local function makeButton(name, text, pos, size, bgCol)
    local btn = create("TextButton", {
        Name = name,
        Position = pos,
        Size = size,
        BackgroundColor3 = bgCol,
        BackgroundTransparency = 0.04,
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = Color3.fromRGB(240, 245, 255),
        TextSize = 11,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
        ZIndex = 5
    }, main)
    corner(btn, 10)
    stroke(btn, bgCol:Lerp(Color3.fromRGB(255, 255, 255), 0.2), 1, 0.3)

    btn.MouseEnter:Connect(function()
        tween(btn, 0.12, { BackgroundColor3 = bgCol:Lerp(Color3.fromRGB(255, 255, 255), 0.12) })
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, 0.12, { BackgroundColor3 = bgCol })
    end)
    return btn
end

