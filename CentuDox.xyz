local function copyLink(url, msg)
    if setclipboard then
        setclipboard(url)
        setStatus(msg, Color3.fromRGB(60, 220, 140))
    else
        setStatus("Clipboard access restricted", Color3.fromRGB(255, 90, 100))
    end
end

getKeyBtn.MouseButton1Click:Connect(function() copyLink(KEY_URL, "Key link copied to clipboard!") end)
discordBtn.MouseButton1Click:Connect(function() copyLink(DISCORD_URL, "Discord invite copied to clipboard!") end)

local verifying = false

verifyBtn.MouseButton1Click:Connect(function()
    if verifying then return end
    local enteredKey = keyBox.Text:match("^%s*(.-)%s*$")

    if enteredKey == "" then
        setStatus("Please input your license key first", Color3.fromRGB(255, 185, 60))
        return
    end

    verifying = true
    verifyBtn.Text = "VERIFYING..."
    setStatus("Connecting to Luarmor network...", Color3.fromRGB(80, 160, 255))

    task.spawn(function()
        local checked, statusResult = pcall(function()
            return api.check_key(enteredKey)
        end)

        if not checked or type(statusResult) ~= "table" then
            setStatus("Network error during verification", Color3.fromRGB(255, 90, 100))
            verifyBtn.Text = "VERIFY ACCESS →"
            verifying = false
            return
        end

        if statusResult.code == "KEY_VALID" then
            saveKey(enteredKey)
            script_key = enteredKey

            setStatus("Access Granted! Unloading UI...", Color3.fromRGB(60, 220, 140))
            verifyBtn.Text = "GRANTED"

            task.wait(0.4)
            
            tween(main, 0.2, { Size = UDim2.fromOffset(360, 280), BackgroundTransparency = 1 })
            tween(glow, 0.2, { BackgroundTransparency = 1 })
            task.wait(0.2)
            gui:Destroy()

            local loaded, err = pcall(function()
                api.load_script()
            end)

            if not loaded then
                warn("Luarmor script execution error:", err)
            end

        elseif statusResult.code == "KEY_HWID_LOCKED" then
            setStatus("Key is bound to another hardware ID", Color3.fromRGB(255, 185, 60))
            verifyBtn.Text = "VERIFY ACCESS →"
            verifying = false

        elseif statusResult.code == "KEY_INCORRECT" then
            setStatus("Invalid or terminated key", Color3.fromRGB(255, 90, 100))
            verifyBtn.Text = "VERIFY ACCESS →"
            verifying = false

        else
            setStatus(tostring(statusResult.message or statusResult.code or "Authentication failed"), Color3.fromRGB(255, 90, 100))
            verifyBtn.Text = "VERIFY ACCESS →"
            verifying = false
        end
    end)
end)

local dragging, dragStart, startPos
title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging, dragStart, startPos = true, input.Position, main.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        glow.Position = main.Position
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

main.Size = UDim2.fromOffset(370, 290)
main.BackgroundTransparency = 1
tween(main, 0.35, { Size = UDim2.fromOffset(420, 330), BackgroundTransparency = 0.02 })
tween(glow, 0.35, { Size = UDim2.fromOffset(450, 360) })
